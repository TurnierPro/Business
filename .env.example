# Stelax OS – Einstellungen. Kopieren nach .env (lokal) bzw. in Coolify als Umgebungsvariablen eintragen.
# Echte Werte gehören NIE ins Repo.

# Adresse, unter der Stelax OS erreichbar ist (für Links in Briefen und Mails)
BASE_URL=http://localhost:3000

# Datenbank: leer lassen = eingebaute Datenbank im Ordner data/ (zum Lernen und Testen)
# Auf dem Server: postgres://benutzer:passwort@host:5432/stelax
DATABASE_URL=

# Ordner für Datenbank, Backups, Demos, Uploads (Standard: ./data)
DATA_DIR=

# Langes Zufallsgeheimnis für Anmeldung und Links (openssl rand -hex 32)
SESSION_SECRET=

# Start-Passwort für die beiden Konten beim allerersten Start
STELAX_START_PASSWORT=

# Pfad zu Chromium für PDFs (nur nötig, wenn Playwright Chromium nicht selbst findet)
CHROMIUM_PATH=

# --- Dienste: leer = Simulator, nichts geht nach draußen ---

# Claude (erst nach Klärung EU-Verarbeitung und AV-Vertrag)
ANTHROPIC_API_KEY=

# E-Mail-Versand über euren Mail-Anbieter
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Stelax Consulting <hallo@stelax.de>"

# Briefdienst (Modul 7). Akquise-Briefe gehen erst raus, wenn zusätzlich AKQUISE_FREIGESCHALTET=ja
BRIEFDIENST_API_KEY=
AKQUISE_FREIGESCHALTET=nein

# Docuseal (E-Signatur), Stripe, lexoffice (Modul 10)
DOCUSEAL_URL=
DOCUSEAL_TOKEN=
STRIPE_SECRET_KEY=
LEXOFFICE_API_KEY=

# Whisper auf eurem Server (Modul 9)
WHISPER_URL=
WHISPER_MODELL=Systran/faster-whisper-large-v3

# Steuerberater (Empfänger für den Quartalsbericht)
STEUERBERATER_EMAIL=

# Push aufs Handy über ntfy, z. B. https://ntfy.sh/stelax-geheimes-thema
NTFY_URL=

# Backups: Ziel auf der Hetzner Storage Box, z. B. u123456@u123456.your-storagebox.de:stelax/
BACKUP_ZIEL=
# Nur bei echter PostgreSQL: leere Test-Datenbank für die Probe-Rücksicherung
RUECKSICHERUNG_DB_URL=
