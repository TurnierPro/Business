# Nexova OS – Einstellungen. Kopieren nach .env (lokal) bzw. in Coolify als Umgebungsvariablen eintragen.
# Echte Werte gehören NIE ins Repo.

# Adresse, unter der Nexova OS erreichbar ist (für Links in Briefen und Mails)
BASE_URL=http://localhost:3000

# Datenbank: leer lassen = eingebaute Datenbank im Ordner data/ (zum Lernen und Testen)
# Auf dem Server: postgres://benutzer:passwort@host:5432/nexova
DATABASE_URL=

# Ordner für Datenbank, Backups, Demos, Uploads (Standard: ./data)
DATA_DIR=

# Langes Zufallsgeheimnis für Anmeldung und Links (openssl rand -hex 32)
SESSION_SECRET=

# Start-Passwort für die beiden Konten beim allerersten Start
NEXOVA_START_PASSWORT=

# Pfad zu Chromium für PDFs (nur nötig, wenn Playwright Chromium nicht selbst findet)
CHROMIUM_PATH=

# --- Dienste: leer = Simulator, nichts geht nach draußen ---

# Claude (erst nach Klärung EU-Verarbeitung und AV-Vertrag)
ANTHROPIC_API_KEY=

# ---------- E-Mail-Versand ----------
# Es wird der erste Weg mit vollständigen Zugangsdaten genutzt: microsoft → google → resend → smtp.
# Fest wählen mit MAIL_DIENST=microsoft|google|resend|smtp|simulator. Anleitung: Stammdaten → Konnektoren.
MAIL_DIENST=
MAIL_ABSENDER_NAME="Nexova Consulting"
# Antworten der Kunden landen in eurem Postfach
MAIL_ANTWORT_AN=hallo@nexova.de

# Microsoft 365 / Outlook (Microsoft Graph, App-Registrierung mit Mail.Send)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_ABSENDER=hallo@nexova.de

# Google Workspace / Gmail (Dienstkonto mit domänenweiter Delegierung, Bereich gmail.send)
GOOGLE_CLIENT_EMAIL=
# Privater Schlüssel aus der JSON-Datei, Zeilenumbrüche als \n
GOOGLE_PRIVATE_KEY=
GOOGLE_ABSENDER=hallo@nexova.de

# Resend. Domain vorher bestätigen (SPF, DKIM, DMARC).
RESEND_API_KEY=
MAIL_FROM="Nexova Consulting <hallo@nexova.de>"

# SMTP eures Mail-Anbieters (IONOS, STRATO, Hetzner …)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nexova Consulting <hallo@nexova.de>"

# ---------- WhatsApp Business (Cloud API von Meta) ----------
# Webhook in Meta: <BASE_URL>/api/whatsapp, Prüftoken = WHATSAPP_VERIFY_TOKEN
WHATSAPP_TOKEN=
WHATSAPP_TELEFON_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Briefdienst (Modul 7). Akquise-Briefe gehen erst raus, wenn zusätzlich AKQUISE_FREIGESCHALTET=ja
BRIEFDIENST_API_KEY=
AKQUISE_FREIGESCHALTET=nein

# Docuseal (E-Signatur), Stripe, lexoffice (Modul 10)
DOCUSEAL_URL=
DOCUSEAL_TOKEN=
# Stripe: Anzahlung im Kundenportal, Rechnungen von Stripe, Schlusszahlung und Betreuung nach Freigabe
STRIPE_SECRET_KEY=
# Webhook in Stripe auf <BASE_URL>/api/stripe/webhook einrichten, Geheimnis hier eintragen
STRIPE_WEBHOOK_SECRET=
# Steuersatz 19 % (exklusiv) im Stripe-Dashboard anlegen, ID hier eintragen (txr_...)
STRIPE_STEUERSATZ_ID=
# stripe (Standard) oder ueberweisung (eigene Rechnungen aus Nexova OS)
ZAHLUNGSWEG=stripe
LEXOFFICE_API_KEY=

# Whisper auf eurem Server (Modul 9)
WHISPER_URL=
WHISPER_MODELL=Systran/faster-whisper-large-v3

# Steuerberater (Empfänger für den Quartalsbericht)
STEUERBERATER_EMAIL=

# Push aufs Handy über ntfy, z. B. https://ntfy.sh/nexova-geheimes-thema
NTFY_URL=

# Backups: Ziel auf der Hetzner Storage Box, z. B. u123456@u123456.your-storagebox.de:nexova/
BACKUP_ZIEL=
# Nur bei echter PostgreSQL: leere Test-Datenbank für die Probe-Rücksicherung
RUECKSICHERUNG_DB_URL=

# Domain-Umzug: öffentliche IPv4 des Servers. Kunden stellen A-Eintrag (@ und www) auf diese Adresse.
SERVER_IP=
# Optional: eigener DNS-Resolver für Abfragen, z. B. 1.1.1.1
DNS_SERVER=
# Nur zum Üben: DNS-Simulator für alle Domains (ja/nein)
DNS_SIMULATOR=

# Backups außerhalb des Servers nur verschlüsselt: lange Passphrase (mind. 32 Zeichen), auch im Passwortmanager ablegen.
# Ohne diesen Schlüssel lässt sich kein Backup wiederherstellen!
BACKUP_SCHLUESSEL=
