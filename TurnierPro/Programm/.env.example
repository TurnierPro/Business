# TurnierPro — optionale Konfiguration
# Normalerweise nicht nötig: Zugänge in der App unter Einstellungen › Zugänge eintragen.
# Wer lieber eine Datei nutzt: nach ~/Library/Application Support/TurnierPro/.env kopieren.

# Anthropic API-Key (für die KI-Vollständigkeitsprüfung)
# → console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Stripe Secret Key (für den Rechnungs-Abruf)
# → dashboard.stripe.com → Entwickler → API-Schlüssel (sk_live_... oder sk_test_...)
STRIPE_API_KEY=

# Optional: verwendetes Claude-Modell (Standard: claude-opus-4-8)
# Günstiger: claude-sonnet-5
CLAUDE_MODEL=claude-opus-4-8

# Optional: Firmenname auf dem Bericht
FIRMENNAME=TurnierPro UG (haftungsbeschränkt)

# E-Mail an den Steuerberater (für den fertigen E-Mail-Entwurf mit Anhängen)
STEUERBERATER_EMAIL=
STEUERBERATER_NAME=Steuerberater
# Eigene Absenderadresse (erscheint als Absender im Entwurf)
ABSENDER_EMAIL=

# Rechnungs-Import aus iCloud Mail (Apple Mail) per IMAP
IMAP_HOST=imap.mail.me.com
IMAP_EMAIL=
# App-spezifisches Passwort: appleid.apple.com → Anmelden & Sicherheit →
# App-spezifische Passwörter → neues Passwort erzeugen (NICHT das normale Passwort!)
IMAP_APP_PASSWORT=
# Namen der Apple-Mail-Ordner mit den Rechnungen (exakt wie in Mail angezeigt)
MAIL_ORDNER_EINGANG=Rechnungen Eingang
MAIL_ORDNER_AUSGANG=Rechnungen Ausgang
