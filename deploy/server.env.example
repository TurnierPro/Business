# .env auf dem Server (Ordner /opt/levarex). Werte aus Bitwarden, Sammlung „Levarex Server“.
# Diese Datei nie ins Git und nie in den Chat. Rechte: chmod 600 .env

# Adressen (DNS: A-Eintrag aller drei auf die Server-IP)
OS_DOMAIN=os.levarex-consulting.de
PORTAL_DOMAIN=portal.levarex-consulting.de
N8N_DOMAIN=n8n.levarex-consulting.de
ACME_EMAIL=technik@levarex-consulting.de
SERVER_IP=

# Datenbank und Sitzungen (je mindestens 32 zufällige Zeichen: openssl rand -base64 32)
POSTGRES_PASSWORD=
SESSION_SECRET=
LEVAREX_START_PASSWORT=

# Sicherung bei IONOS Object Storage (siehe docs/runbook-server.md, Schritt 6)
S3_ENDPOINT=https://s3.eu-central-3.ionoscloud.com
S3_REGION=eu-central-3
S3_BUCKET=levarex-sicherung
S3_ZUGRIFF=
S3_GEHEIM=
BACKUP_SCHLUESSEL=

# n8n: Version fest (nur bewusst erhöhen), Schlüssel für die Zugangsdaten in n8n (in Bitwarden!)
N8N_VERSION=
N8N_ENCRYPTION_KEY=

# Alle weiteren Dienste (Mail, Lexware, Qonto, WhatsApp …) wie in .env.example
